---
import config from '@config';
import ThemeSelect from './theme/ThemeSelect.astro';

const isHome = Astro.url.pathname === '/';
---

<header class:list={['flex', { 'pb-18': isHome }]}>
  {!isHome && (
    <a
      href="/"
      aria-label="Back to home"
      class="button text-text mb-16 flex size-18 items-center justify-center transition-transform duration-300 ease-[cubic-bezier(.11,1.3,.79,1.19)] hover:scale-130"
    >
      <svg width="24" height="24" viewBox="0 0 100 100" transform="rotate(90)" aria-hidden="true">
        <path d="M50.5,19.881c-1.104,0-2,0.896-2,2V72.17L33.193,56.609c-0.781-0.781-1.922-0.781-2.703,0 c-0.781,0.78-0.719,2.047,0.062,2.828l18.883,18.857c0.375,0.375,0.899,0.586,1.43,0.586s1.047-0.211,1.422-0.586l18.857-18.857 c0.781-0.781,0.783-2.048,0.002-2.828c-0.781-0.781-2.296-0.781-3.077,0L52.5,71.933V21.881C52.5,20.776,51.604,19.881,50.5,19.881 z" />
      </svg>
    </a>
  )}
  {config.theme.enableUserChange && (
    <div class="ml-auto">
      <ThemeSelect />
    </div>
  )}
</header>
