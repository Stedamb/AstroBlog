---
import config from '@config';
import { render } from 'astro:content';
import AffixTitle from '@/components/AffixTitle.astro';
import Toc from '@/components/Toc.astro';
import PageLayout from '@/layouts/PageLayout.astro';
import { formatDate } from '@/lib/date';
import { getPosts, type Post } from '@/lib/posts';
import 'remark-block-containers/css';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { title, description, pubDate } = post.data;
const { Content, remarkPluginFrontmatter, headings } = await render(post);

const minutesRead: string | undefined = config.readTime ? remarkPluginFrontmatter['minutesRead'] : undefined;
const lastModified: Date | undefined =
  config.lastModified && remarkPluginFrontmatter['lastModified']
    ? new Date(remarkPluginFrontmatter['lastModified'])
    : undefined;
---

<PageLayout title={title} description={description} article={{ published: pubDate, modified: lastModified }}>
  <AffixTitle title={title} offsetTop={100} />

  <article class="blog-content">
    <header class="mb-16">
      <h1 class="font-title text-text text-5xl font-bold">{title}</h1>
      <div class="text-text-light mt-2 flex items-center gap-2 font-mono text-lg">
        {pubDate ? (
          <time datetime={pubDate.toISOString()}>{formatDate(pubDate, config.lang, { omitCurrentYear: true })}</time>
        ) : (
          <span>Draft</span>
        )}
        {minutesRead && <span aria-hidden="true">·</span>}
        {minutesRead && <span>{minutesRead}</span>}
      </div>
    </header>

    <Content />

    {lastModified && (
      <div class="text-text-light">
        Last edited{' '}
        <time datetime={lastModified.toISOString()}>
          {formatDate(lastModified, config.lang, { omitCurrentYear: true })}
        </time>
      </div>
    )}
  </article>

  <Toc headings={headings} class="fixed top-0 right-2 bottom-0 hidden w-64 xl:block" />
</PageLayout>

<script>
  import { useCodeGroups as initCodeGroups } from 'remark-block-containers/useCodeGroups';

  initCodeGroups();
</script>
