---
import config from '@config';
import PageLayout from '@/layouts/PageLayout.astro';
import { formatDate } from '@/lib/date';
import { getPostUrl, getPosts } from '@/lib/posts';

const posts = await getPosts();
---

<PageLayout>
  <section class="mb-16">
    <h1 class="font-title text-text text-6xl">{config.title}</h1>
    <p class="text-text-light mt-2 font-mono text-lg">{config.description}</p>
  </section>

  <section class="mb-16">
    <ul class="text-2xl">
      {posts.map((post) => (
        <li>
          <a
            class="link text-text border-text-light hover:text-foreground flex flex-col justify-between border-b border-dashed py-3 transition-transform duration-200 ease-in-out hover:scale-[0.98] active:scale-[0.95] sm:flex-row sm:items-center sm:border-0 sm:px-6"
            href={getPostUrl(post)}
          >
            <span class="shrink-0 font-normal transition-colors">{post.data.title}</span>
            <span class="border-text-light mx-8 hidden h-px w-full grow border-t border-dashed sm:flex" />
            <span class="text-text-light shrink-0 font-mono text-lg font-light italic">
              {post.data.pubDate ? (
                <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate, config.lang)}</time>
              ) : (
                'Draft'
              )}
            </span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</PageLayout>
